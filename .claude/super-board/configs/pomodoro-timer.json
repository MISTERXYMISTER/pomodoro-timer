      "**/yarn.lock",
      "**/pnpm-lock.yaml",
      "**/bun.lockb",
      "**/bun.lock",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/out/**",
      "**/node_modules/**",
      "**/*.min.*",
      "**/*.map",
      "**/__snapshots__/**",
      "**/*.snap"
    ]
  },
  "verify_commands": [
    "/home/itachi/software-factory/scripts/contained-verify.sh npm test",
    "/home/itachi/software-factory/scripts/contained-verify.sh npm run lint",
    "/home/itachi/software-factory/scripts/contained-verify.sh npm run build"
